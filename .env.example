# FoodLoop settings. Copy this file to ".env" (the setup steps in README do it for you).
# ".env" holds your own machine's settings and is never committed to git.

APP_NAME=FoodLoop
APP_ENV=local
# Filled in by: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# The address you open in the browser.
# "php artisan serve" uses http://localhost:8000 · Laragon/Herd sites use http://foodloop.test
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MySQL 8 -------------------------------------------------------
# These are Laragon's defaults: user "root" with an empty password.
# If your MySQL has a password, put it in DB_PASSWORD.
# Create the databases once (see README): "foodloop" and "foodloop_test".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodloop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Listing photos are stored in storage/app/public (linked by: php artisan storage:link).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Emails are not sent in the prototype; they are written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@foodloop.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
